# ─── Lärk ─────────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" e preencha o que quiser. Tudo é opcional:
# a chave do Gemini também pode ser colada direto em Configurações, na interface.

# ─── Cérebro (Google AI Studio — gratuito) ───────────────────────────────
# Crie a sua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos por função (vazio = automático: o Lärk escolhe o melhor modelo gratuito disponível
# e troca sozinho quando um deles estiver sem cota ou sobrecarregado).
LARK_MODEL_CHAT=
LARK_MODEL_FAST=
LARK_MODEL_TTS=
LARK_MODEL_LIVE=
LARK_MODEL_EMBEDDING=

# ─── Servidor ────────────────────────────────────────────────────────────
# Porta da interface/API (http://localhost:8787)
PORT=8787
# Endereço em que o servidor escuta. 127.0.0.1 = só este computador (recomendado).
# Para acessar pelo celular na mesma rede use 0.0.0.0 — e então LARK_PASSWORD é obrigatória.
HOST=127.0.0.1
# Seu fuso horário (IANA). Usado em lembretes, cobranças e no briefing.
TZ=America/Sao_Paulo

# ─── Segurança ───────────────────────────────────────────────────────────
# Senha de acesso à interface. Obrigatória se HOST não for 127.0.0.1/localhost:
# o Lärk tem acesso ao seu computador e não pode ficar aberto na rede sem senha.
LARK_PASSWORD=
# Nomes de host extras aceitos (separados por vírgula), ex.: lark.minha-casa.dev
LARK_ALLOWED_HOSTS=

# ─── Dados ───────────────────────────────────────────────────────────────
# Onde fica a memória permanente (banco SQLite). Faça backup deste arquivo!
LARK_DB_PATH=./data/lark.db

# ─── Demonstração ────────────────────────────────────────────────────────
# 1 = modo demonstração: respostas simuladas, sem chamar o Gemini (bom para testar a interface).
LARK_MOCK=0
