# ─── Lärk ────────────────────────────────────────────────────────────────
# Porta do servidor
PORT=8787
# Seu fuso horário (IANA)
TZ=America/Sao_Paulo
# Opcional: senha para proteger o Lärk quando hospedado na internet
LARK_PASSWORD=
# Onde fica o banco SQLite (memória permanente)
LARK_DB_PATH=./data/lark.db

# ─── Provedores de IA (APIs gratuitas) ───────────────────────────────────
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Ordem de tentativa (fallback automático)
LARK_PROVIDER_ORDER=gemini,groq,openrouter

# Embeddings para busca semântica na memória (usa a chave do Gemini)
LARK_EMBEDDING_MODEL=gemini-embedding-001

# Modo demonstração sem chave (respostas simuladas)
LARK_MOCK=0
