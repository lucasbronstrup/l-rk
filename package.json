{
  "name": "lark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lärk — assistente pessoal estilo Jarvis com memória persistente",
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "clipboardy": "^5.3.2",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "mathjs": "^15.2.0",
    "motion": "^14.3.0",
    "node-html-parser": "^9.0.4",
    "open": "^11.0.4",
    "openai": "^7.34.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "screenshot-desktop": "^1.15.7",
    "systeminformation": "^5.33.15",
    "trash": "^10.1.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,gray \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server/index.js",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "start": "node scripts/lark.mjs --no-open",
    "lark": "node scripts/lark.mjs",
    "autostart": "node scripts/autostart.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
